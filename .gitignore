# ==============================================================================
# MINALE + MANN DECOUPLED ARCHITECTURE - ROOT .GITIGNORE
# ==============================================================================

# Next.js Build & Runtime Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/

# Next.js Build Logs & Caches
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (Never commit production credentials)
.env
.env*.local
frontend/.env
frontend/.env*.local
!frontend/.env.example

# Backend Database Credentials & Configs
backend/.env
backend/.env*.local
backend/api/config/db_credentials.php
!backend/api/config/db_credentials.example.php

# Uploaded User Media (Preserve uploads directory via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/.htaccess

# OS Generated Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Server Logs
*.log
error_log
